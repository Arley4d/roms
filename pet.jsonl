{"type": "file", "p": "17 und 4 (19xx)(-)(de).zip", "n": "17 und 4 (19xx)(-)(de)", "ext": ".zip", "parent": "", "urls": [{"u": "https://archive.org/download/tosec-20161111-commodore-pet/TOSEC.2016.11.11.Commodore.PET.AlphaBot.zip/TOSEC.2016.11.11.Commodore.PET.AlphaBot%2FCommodore%20PET%20-%20Games%2F17%20und%204%20%2819xx%29%28-%29%28de%29.zip", "size": "3.83 KB", "size_bytes": 3921}], "meta": {"path": "./17 und 4 (19xx)(-)(de).zip", "name": "17 und 04", "desc": "⬇ Tamaño de descarga: 3.83 KB\n\n\"17 und 04\" es un juego de Blackjack que solo se puede jugar en alemán.", "image": "Z:/Digistorage/Arley4dCloudMedia/pet/images/17 und 4 (19xx)(-)(de)-image.png", "video": "Z:/Digistorage/Arley4dCloudMedia/pet/videos/17 und 4 (19xx)(-)(de)-video.mp4", "releasedate": "19870101T000000", "developer": "Ph. Bertschg", "publisher": "Commodore Disc", "genre": "Casino / Cartas", "players": "1", "region": "eu", "md5": "da7bd53b378a267e83ff2051a2dcf1f9", "lang": "de"}, "size_bytes": 3921, "size": "3.83 KB"}
{"type": "file", "p": "Bomber (19xx)(-)(de).zip", "n": "Bomber (19xx)(-)(de)", "ext": ".zip", "parent": "", "urls": [{"u": "https://archive.org/download/tosec-20161111-commodore-pet/TOSEC.2016.11.11.Commodore.PET.AlphaBot.zip/TOSEC.2016.11.11.Commodore.PET.AlphaBot%2FCommodore%20PET%20-%20Games%2FBomber%20%2819xx%29%28-%29%28de%29.zip", "size": "3.32 KB", "size_bytes": 3399}], "meta": {"path": "./Bomber (19xx)(-)(de).zip", "name": "Bomber", "desc": "⬇ Tamaño de descarga: 3.32 KB\n\nBomber has you catching falling bombs before they hit the ground and blow everything apart. Each round grows faster and more unpredictable, pushing you to dart back and forth without missing a single drop. The gritty title screen also hints at the word's second meaning – you're not just chasing explosives, but a bit of street-sprayer attitude as well.", "image": "Z:/Digistorage/Arley4dCloudMedia/pet/images/Bomber (19xx)(-)(de)-image.png", "thumbnail": "Z:/Digistorage/Arley4dCloudMedia/pet/images/Bomber (19xx)(-)(de)-thumb.png", "marquee": "Z:/Digistorage/Arley4dCloudMedia/pet/images/Bomber (19xx)(-)(de)-marquee.png", "video": "Z:/Digistorage/Arley4dCloudMedia/pet/videos/Bomber (19xx)(-)(de)-video.mp4", "boxback": "Z:/Digistorage/Arley4dCloudMedia/pet/images/Bomber (19xx)(-)(de)-boxback.png", "releasedate": "19920101T000000", "developer": "Active Developments", "publisher": "Future Publishing", "genre": "Acción", "players": "1", "region": "eu", "md5": "d4c1f98c852e55cd23984a71991ef493", "lang": "de"}, "size_bytes": 3399, "size": "3.32 KB"}
